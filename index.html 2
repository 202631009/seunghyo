html_content = """<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오늘 비 올 확률 - 우산 챙길까?</title>
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Pretendard', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 28px;
            padding: 40px 30px;
            text-align: center;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        }

        h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #38bdf8;
            margin-bottom: 8px;
        }

        p.subtitle {
            font-size: 0.95rem;
            color: #94a3b8;
            margin-bottom: 30px;
        }

        .status-card {
            background: rgba(15, 23, 42, 0.6);
            border-radius: 20px;
            padding: 30px 20px;
            margin-bottom: 30px;
            border: 1px dashed rgba(56, 189, 248, 0.3);
            min-height: 220px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .weather-icon {
            font-size: 5rem;
            line-height: 1.2;
            margin-bottom: 12px;
        }

        .rain-percentage {
            font-size: 2.2rem;
            font-weight: 800;
            color: #f8fafc;
            margin-bottom: 6px;
        }

        .umbrella-advice {
            font-size: 1.1rem;
            font-weight: 600;
            color: #38bdf8;
        }

        .btn-check {
            font-size: 1.2rem;
            font-weight: 600;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            border: none;
            padding: 16px 36px;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.4);
            transition: all 0.2s ease;
            width: 100%;
            outline: none;
        }

        .btn-check:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(2, 132, 199, 0.5);
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
        }

        .btn-check:active {
            transform: translateY(1px);
        }

        .pop-anim {
            animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes pop {
            0% { transform: scale(0.6); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        footer {
            margin-top: 25px;
            font-size: 0.8rem;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>오늘 비가 올까? 🌧️</h1>
        <p class="subtitle">실시간 위치 기반으로 강수확률을 조회해보세요.</p>

        <div class="status-card">
            <div id="icon" class="weather-icon">🌈</div>
            <div id="rain-percent" class="rain-percentage">--%</div>
            <div id="advice" class="umbrella-advice">버튼을 눌러 확인하세요!</div>
        </div>

        <button class="btn-check" onclick="getRainProbability()">오늘 비 올 확률 ☂️</button>
    </div>

    <footer>
        <p>Open-Meteo Weather API 연동</p>
    </footer>

    <script>
        async function getRainProbability() {
            const iconEl = document.getElementById('icon');
            const percentEl = document.getElementById('rain-percent');
            const adviceEl = document.getElementById('advice');

            percentEl.textContent = '조회 중...';
            adviceEl.textContent = '기상 데이터를 불러오는 중입니다.';

            // 위치 정보를 받아와 실제 날씨 조회 (실패 시 서울 좌표 기본 사용)
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        fetchWeather(position.coords.latitude, position.coords.longitude);
                    },
                    () => {
                        // 위치 권한 거부 시 서울 기준
                        fetchWeather(37.5665, 126.9780);
                    }
                );
            } else {
                fetchWeather(37.5665, 126.9780);
            }
        }

        async function fetchWeather(lat, lon) {
            const iconEl = document.getElementById('icon');
            const percentEl = document.getElementById('rain-percent');
            const adviceEl = document.getElementById('advice');

            try {
                // Open-Meteo API 호출 (오늘 하루 최고 강수확률 조회)
                const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=precipitation_probability_max&timezone=auto`);
                const data = await response.json();
                
                const rainProb = data.daily.precipitation_probability_max[0];
                percentEl.textContent = `강수확률 ${rainProb}%`;

                // 강수확률에 따른 우산 지침 및 이모지 설정
                if (rainProb >= 70) {
                    iconEl.textContent = '🌧️';
                    adviceEl.textContent = '우산 꼭 챙기세요! 비가 올 확률이 매우 높아요.';
                    adviceEl.style.color = '#f43f5e'; // Red
                } else if (rainProb >= 40) {
                    iconEl.textContent = '🌦️';
                    adviceEl.textContent = '접이식 우산 하나 챙기시는 걸 추천해요!';
                    adviceEl.style.color = '#fbbf24'; // Yellow
                } else if (rainProb >= 20) {
                    iconEl.textContent = '⛅';
                    adviceEl.textContent = '흐릿하지만 우산 없이 나가도 괜찮을 것 같아요.';
                    adviceEl.style.color = '#38bdf8'; // Blue
                } else {
                    iconEl.textContent = '☀️';
                    adviceEl.textContent = '우산은 집에 두고 가세요! 가벼운 발걸음으로 출발~';
                    adviceEl.style.color = '#4ade80'; // Green
                }

                iconEl.classList.remove('pop-anim');
                void iconEl.offsetWidth;
                iconEl.classList.add('pop-anim');

            } catch (error) {
                // API 오류 발생 시 모의 데이터 제공
                const mockProb = Math.floor(Math.random() * 10) * 10;
                percentEl.textContent = `강수확률 ${mockProb}% (임시)`;
                adviceEl.textContent = mockProb >= 50 ? '우산을 챙기시는 것이 좋아 보여요!' : '오늘은 우산 없이 외출해도 좋을 것 같아요.';
            }
        }
    </script>
</body>
</html>
"""

with open("rain_probability_checker.html", "w", encoding="utf-8") as f:
    f.write(html_content)

print("Rain Probability HTML file generated successfully.")
